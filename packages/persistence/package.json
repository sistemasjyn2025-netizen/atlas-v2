{
  "name": "@atlas/persistence",
  "version": "0.1.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "prisma generate --schema=./prisma/schema.prisma && tsc -b",
    "test": "jest",
    "clean": "rm -rf dist",
    "db:generate": "prisma generate --schema=./prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=./prisma/schema.prisma",
    "db:push": "prisma db push --schema=./prisma/schema.prisma"
  },
  "dependencies": {
    "@atlas/types": "workspace:*",
    "@atlas/manufacturing-engine": "workspace:*",
    "@atlas/cost-engine": "workspace:*",
    "@prisma/client": "^5.16.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "jest": "^29.5.0",
    "@types/jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "prisma": "^5.16.0"
  }
}
